@model SafeRouteSA.Web.Models.Incident
@using SafeRouteSA.Web.Models
@using System.Globalization

@{
    ViewData["Title"] = "Incident Details";

    var latitude = Model.Latitude.ToString(CultureInfo.InvariantCulture);
    var longitude = Model.Longitude.ToString(CultureInfo.InvariantCulture);
}

@section Styles {
    <link rel="stylesheet"
          href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoT4llR2s0q5c="
          crossorigin="" />

    <link rel="stylesheet"
          href="~/css/incident.css"
          asp-append-version="true" />

    <style>
        #detailsMap {
            width: 100%;
            height: 350px;
            border-radius: 12px;
            z-index: 0;
        }

        .sr-detail-card {
            height: 100%;
        }

        .sr-feedback {
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            border-radius: 12px;
            padding: 20px;
        }

        .sr-feedback-notes {
            white-space: pre-wrap;
            overflow-wrap: anywhere;
        }

        .sr-detail-label {
            color: #64748b;
            font-size: 0.9rem;
            margin-bottom: 4px;
        }

        .sr-detail-value {
            font-weight: 600;
            margin-bottom: 18px;
        }
    </style>
}

<div class="incident-page">

    <!-- HEADER -->
    <div class="incident-header">
        <div>
            <span class="eyebrow">INCIDENT DETAILS</span>

            <h1>@Model.Title</h1>

            <p>Reference: @Model.ReferenceNumber</p>
        </div>

        <a asp-controller="Incidents"
           asp-action="Index"
           class="btn btn-outline-secondary">
            Back to Reports
        </a>
    </div>

    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success">
            @success
        </div>
    }

    <!-- DEMO WARNING -->
    <div class="alert alert-warning">
        <strong>Demo platform only.</strong>
        No emergency services have been contacted.
    </div>

    <!-- STATUS CARDS -->
    <div class="row g-4 mb-4">

        <!-- APPROVAL STATUS -->
        <div class="col-md-6">
            <div class="incident-card sr-detail-card">

                <h4>Approval Status</h4>
                <hr />

                @switch (Model.ApprovalStatus)
                {
                    case IncidentApprovalStatus.Pending:
                        <span class="badge bg-warning text-dark fs-6">
                            Pending Approval
                        </span>

                        <p class="text-muted mt-3">
                            Your report is awaiting administrator review.
                        </p>
                        break;

                    case IncidentApprovalStatus.Approved:
                        <span class="badge bg-success fs-6">
                            Approved
                        </span>

                        <p class="text-muted mt-3">
                            Your incident report has been approved
                            by the SafeRoute SA administrator.
                        </p>
                        break;

                    case IncidentApprovalStatus.Rejected:
                        <span class="badge bg-danger fs-6">
                            Rejected
                        </span>

                        <p class="text-muted mt-3">
                            Your report was not approved.
                            Please check the administrator feedback below.
                        </p>
                        break;

                    default:
                        <span class="badge bg-secondary fs-6">
                            Unknown Status
                        </span>
                        break;
                }

            </div>
        </div>

        <!-- INCIDENT PROGRESS -->
        <div class="col-md-6">
            <div class="incident-card sr-detail-card">

                <h4>Incident Progress</h4>
                <hr />

                @switch (Model.Status)
                {
                    case IncidentStatus.Pending:
                        <span class="badge bg-secondary fs-6">
                            Pending
                        </span>
                        break;

                    case IncidentStatus.UnderReview:
                        <span class="badge bg-info text-dark fs-6">
                            Under Review
                        </span>
                        break;

                    case IncidentStatus.InProgress:
                        <span class="badge bg-primary fs-6">
                            In Progress
                        </span>
                        break;

                    case IncidentStatus.Resolved:
                        <span class="badge bg-success fs-6">
                            Resolved
                        </span>
                        break;

                    case IncidentStatus.Closed:
                        <span class="badge bg-dark fs-6">
                            Closed
                        </span>
                        break;

                    default:
                        <span class="badge bg-secondary fs-6">
                            Unknown
                        </span>
                        break;
                }

                <p class="text-muted mt-3">
                    Incident progress is tracked separately
                    from administrator approval.
                </p>

            </div>
        </div>

    </div>

    <!-- ADMINISTRATOR FEEDBACK -->
    <div class="incident-card mb-4">

        <h4>Administrator Feedback</h4>
        <hr />

        @if (Model.ApprovalStatus ==
             IncidentApprovalStatus.Pending)
        {
            <div class="sr-feedback">
                <p class="text-muted mb-0">
                    Your report has not been reviewed yet.
                    Please check back later for an update.
                </p>
            </div>
        }
        else if (Model.ApprovalStatus ==
                 IncidentApprovalStatus.Approved ||
                 Model.ApprovalStatus ==
                 IncidentApprovalStatus.Rejected)
        {
            <div class="sr-feedback">

                <p class="sr-detail-label">
                    Review Decision
                </p>

                <p class="sr-detail-value">
                    @Model.ApprovalStatus
                </p>

                <p class="sr-detail-label">
                    Administrator Notes
                </p>

                <p class="sr-feedback-notes">
                    @(string.IsNullOrWhiteSpace(Model.ReviewNotes)
                        ? "No additional feedback provided."
                        : Model.ReviewNotes)
                </p>

                <p class="sr-detail-label">
                    Date Reviewed
                </p>

                <p class="sr-detail-value mb-0">
                    @(Model.ReviewedAtUtc.HasValue
                        ? Model.ReviewedAtUtc.Value.ToString(
                            "dd MMM yyyy HH:mm") + " UTC"
                        : "Not recorded")
                </p>

            </div>
        }
        else
        {
            <div class="sr-feedback">
                <p class="text-muted mb-0">
                    Administrator feedback is unavailable.
                </p>
            </div>
        }

    </div>

    <!-- REPORT INFORMATION AND LOCATION -->
    <div class="row g-4">

        <!-- REPORT INFORMATION -->
        <div class="col-lg-5">
            <div class="incident-card sr-detail-card">

                <h4>Report Information</h4>
                <hr />

                <p class="sr-detail-label">
                    Reference Number
                </p>

                <p class="sr-detail-value">
                    @Model.ReferenceNumber
                </p>

                <p class="sr-detail-label">
                    Category
                </p>

                <p class="sr-detail-value">
                    @Model.Category
                </p>

                <p class="sr-detail-label">
                    Date Reported
                </p>

                <p class="sr-detail-value">
                    @Model.CreatedAtUtc.ToString(
                        "dd MMM yyyy HH:mm") UTC
                </p>

                <h5>Description</h5>

                <p class="incident-description">
                    @Model.Description
                </p>

                <h5>Location Description</h5>

                <p>
                    @(string.IsNullOrWhiteSpace(
                        Model.LocationDescription)
                        ? "Not provided"
                        : Model.LocationDescription)
                </p>

            </div>
        </div>

        <!-- INCIDENT MAP -->
        <div class="col-lg-7">
            <div class="incident-card sr-detail-card">

                <h4>Incident Location</h4>
                <hr />

                <div id="detailsMap"
                     role="region"
                     aria-label="Reported incident location">
                </div>

                <p class="mt-3 text-muted small">
                    Latitude: @Model.Latitude |
                    Longitude: @Model.Longitude
                </p>

                <p class="small text-muted">
                    The map marker shows the location
                    submitted with this incident report.
                </p>

            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin="">
    </script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const latitude = @latitude;
            const longitude = @longitude;

            const map = L.map("detailsMap")
                .setView([latitude, longitude], 15);

            L.tileLayer(
                "https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",
                {
                    attribution: "&copy; OpenStreetMap contributors",
                    maxZoom: 19
                }
            ).addTo(map);

            L.marker([latitude, longitude])
                .addTo(map)
                .bindPopup("Reported incident location")
                .openPopup();

            setTimeout(function () {
                map.invalidateSize();
            }, 150);
        });
    </script>
}
